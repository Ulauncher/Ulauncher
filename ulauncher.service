[Unit]
Description=Ulauncher service
Documentation=https://ulauncher.io/
After=graphical-session.target

[Service]
BusName=io.ulauncher.Ulauncher
Type=dbus
# Only restart on failure, to prevent hammering restart retries if the app is already running
Restart=on-failure
RestartSec=1
ExecStart=/usr/bin/ulauncher start

[Install]
WantedBy=graphical-session.target
