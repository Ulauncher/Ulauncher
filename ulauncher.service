[Unit]
Description=Linux Application Launcher
Documentation=https://ulauncher.io/

[Service]
Type=simple
# Clean exits (losing the DBus name race to an XDG-autostarted instance, or a user-initiated
# quit) would otherwise restart the service until systemd's start limit fails the unit.
Restart=on-failure
RestartSec=1
ExecStart=env GDK_BACKEND=x11 /usr/bin/ulauncher --hide-window

[Install]
WantedBy=graphical-session.target
